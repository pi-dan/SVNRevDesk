<Window x:Class="SVNRevDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SVNRevDesk.Desktop.ViewModels"
        xmlns:converters="clr-namespace:SVNRevDesk.Desktop.Converters"
        xmlns:views="clr-namespace:SVNRevDesk.Desktop.Views"
        xmlns:services="clr-namespace:SVNRevDesk.Desktop.Services"
        Title="SVNRevDesk" Icon="Assets/AppIcon.ico" ShowInTaskbar="True" Width="1380" Height="860" MinWidth="1000" MinHeight="620"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonUp="Window_FileDragMouseUp" LostMouseCapture="Window_FileDragLostCapture">
  <Window.Resources>
    <Style x:Key="BreadcrumbLinkStyle" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedText}" /></Trigger>
      </Style.Triggers>
    </Style>
    <converters:FileIconConverter x:Key="FileIconConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style x:Key="DirectoryTreeSummaryStyle" TargetType="TextBlock">
      <Style.Triggers>
        <Trigger Property="Text" Value="已检查项无差异"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="BrowserContextMenu" x:Shared="False" Opened="BrowserContextMenu_Opened">
      <MenuItem Header="新建" Tag="new-item" />
      <MenuItem Header="复制" Tag="file-copy" InputGestureText="Ctrl+C" Click="ClipboardMenu_Click" />
      <MenuItem Header="剪切" Tag="file-cut" InputGestureText="Ctrl+X" Click="ClipboardMenu_Click" ToolTip="在本软件内粘贴移动，保留 SVN 历史；粘贴前不改变源文件。" />
      <MenuItem Header="粘贴" Tag="file-paste" InputGestureText="Ctrl+V" Click="ClipboardMenu_Click" />
      <Separator />
      <MenuItem Header="打开" Tag="open" Click="Operation_Click" />
      <MenuItem Header="在资源管理器中显示" Tag="show-in-explorer" Click="Operation_Click" />
      <MenuItem Header="导出所选到文件夹…" Tag="export" Click="Operation_Click" />
      <MenuItem Header="更新到最新" Tag="update" Click="Operation_Click" />
      <MenuItem Header="更新到指定修订号…" Tag="update-revision" Click="Operation_Click" />
      <MenuItem Header="回滚指定提交（反向合并）…" Tag="reverse-merge" Click="Operation_Click" />
      <MenuItem Header="提交所选…" Tag="commit" Click="Operation_Click" />
      <Separator />
      <MenuItem Header="与服务器比较" Tag="compare-server" Click="Operation_Click" />
      <MenuItem Header="与基础版本比较" Tag="compare-base" Click="Operation_Click" />
      <MenuItem Header="查看历史" Tag="log" Click="Operation_Click" />
      <MenuItem Header="获取锁…" Tag="lock" Click="Operation_Click" />
      <MenuItem Header="释放锁" Tag="unlock" Click="Operation_Click" />
      <Separator />
      <MenuItem Header="添加到版本控制" Tag="add" Click="Operation_Click" />
      <MenuItem Header="忽略（仅本机）" Tag="ignore" Click="Operation_Click" />
      <MenuItem Header="删除…" Tag="delete" Click="Operation_Click" />
      <MenuItem Header="撤销本地修改…" Tag="revert" Click="Operation_Click" />
      <MenuItem Header="重命名 / 移动…" Tag="move" Click="Operation_Click" />
      <MenuItem Header="批量重命名…" Tag="batch-rename" Click="Operation_Click" />
      <MenuItem Header="移动到文件夹…" Tag="move-to" Click="Operation_Click" />
      <MenuItem Header="解决冲突…" Tag="resolve" Click="Operation_Click" />
    </ContextMenu>
    <ContextMenu x:Key="DirectoryContextMenu" Opened="BrowserContextMenu_Opened" Closed="DirectoryContextMenu_Closed">
      <MenuItem Header="新建" Tag="new-item" />
      <MenuItem Header="复制" Tag="file-copy" InputGestureText="Ctrl+C" Click="ClipboardMenu_Click" />
      <MenuItem Header="剪切" Tag="file-cut" InputGestureText="Ctrl+X" Click="ClipboardMenu_Click" ToolTip="在本软件内粘贴移动，保留 SVN 历史；粘贴前不改变源目录。" />
      <MenuItem Header="粘贴" Tag="file-paste" InputGestureText="Ctrl+V" Click="ClipboardMenu_Click" />
      <Separator />
      <MenuItem Header="打开" Tag="open" Click="DirectoryOperation_Click" />
      <MenuItem Header="在资源管理器中显示" Tag="show-in-explorer" Click="DirectoryOperation_Click" />
      <MenuItem Header="刷新此目录" Tag="tree-refresh" Click="DirectoryOperation_Click" />
      <MenuItem Header="更新到最新（含子目录）" Tag="update" Click="DirectoryOperation_Click" />
      <MenuItem Header="更新到指定修订号…" Tag="update-revision" Click="DirectoryOperation_Click" />
      <MenuItem Header="回滚指定提交（反向合并）…" Tag="reverse-merge" Click="DirectoryOperation_Click" />
      <MenuItem Header="提交此目录…" Tag="commit" Click="DirectoryOperation_Click" />
      <MenuItem Header="导出到文件夹…" Tag="export" Click="DirectoryOperation_Click" />
      <Separator />
      <MenuItem Header="与服务器比较" Tag="compare-server" Click="DirectoryOperation_Click" />
      <MenuItem Header="与基础版本比较" Tag="compare-base" Click="DirectoryOperation_Click" />
      <MenuItem Header="查看历史" Tag="log" Click="DirectoryOperation_Click" />
      <MenuItem Header="查看属性" Tag="properties" Click="DirectoryOperation_Click" />
      <MenuItem Header="设置属性 / 忽略规则…" Tag="set-property" Click="DirectoryOperation_Click" />
      <Separator />
      <MenuItem Header="添加到版本控制" Tag="add" Click="DirectoryOperation_Click" />
      <MenuItem Header="忽略（仅本机）" Tag="ignore" Click="DirectoryOperation_Click" />
      <MenuItem Header="删除…" Tag="delete" Click="DirectoryOperation_Click" />
      <MenuItem Header="撤销本地修改…" Tag="revert" Click="DirectoryOperation_Click" />
      <MenuItem Header="重命名 / 移动…" Tag="move" Click="DirectoryOperation_Click" />
      <MenuItem Header="移动到文件夹…" Tag="move-to" Click="DirectoryOperation_Click" />
      <MenuItem Header="解决冲突…" Tag="resolve" Click="DirectoryOperation_Click" />
    </ContextMenu>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="Padding" Value="5,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ToggleButton x:Name="Expander" Focusable="False" Width="16" Height="20" VerticalAlignment="Center"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="#738298" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" /></Border>
                  <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Border x:Name="HeaderBorder" Grid.Column="1" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,2">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
              </Border>
              <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed" /></Trigger>
              <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SelectionBackground}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderBorder" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNode}" ItemsSource="{Binding Children}">
      <Grid>
        <Grid.ToolTip><StackPanel MaxWidth="380"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding DisplaySummary}" Style="{StaticResource DirectoryTreeSummaryStyle}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Grid.ToolTip>
        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Top">
          <Image.Style>
            <Style TargetType="Image">
              <Setter Property="Source" Value="{StaticResource FileIconFolder}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Source" Value="{StaticResource FileIconFolderOpen}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Image.Style>
        </Image>
        <StackPanel Grid.Column="1">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource IgnoredTreeBadge}"><TextBlock Text="⊘ 已忽略" FontSize="10" FontWeight="SemiBold" /></Border>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter Property="Foreground" Value="#64748B" /><Setter Property="FontStyle" Value="Italic" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </DockPanel>
          <TextBlock Text="{Binding DisplaySummary}" Foreground="#768398" FontSize="11" TextTrimming="CharacterEllipsis">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DirectoryTreeSummaryStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <DockPanel Background="{StaticResource PageBackground}">
    <Menu DockPanel.Dock="Top" IsEnabled="{Binding CanOperate}" Padding="12,5" Background="White">
      <MenuItem Header="文件" SubmenuOpened="MainMenu_SubmenuOpened">
        <MenuItem Header="打开本地工作副本…" Click="OpenLocal_Click" />
        <MenuItem Header="打开仓库地址…" Click="OpenUrl_Click" />
        <MenuItem Header="检出到本地…" Tag="checkout" Click="Operation_Click" />
        <MenuItem Header="关联本地工作副本…" Tag="associate" Click="Operation_Click" />
        <MenuItem Header="工作副本与 URL 关联列表…" Click="WorkingCopyLinks_Click" />
        <Separator />
        <MenuItem Header="设置…" Click="Settings_Click" />
        <MenuItem Header="本次会话登录…" Click="Login_Click" />
        <MenuItem Header="关闭当前仓库会话" InputGestureText="Ctrl+W" Click="CloseSession_Click" />
        <Separator />
        <MenuItem Header="退出软件" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="工作副本" SubmenuOpened="MainMenu_SubmenuOpened">
        <MenuItem Header="更新当前目录（含子目录）" Tag="update-directory" Click="Operation_Click" />
        <MenuItem Header="当前目录更新到指定修订号…" Tag="update-directory-revision" Click="Operation_Click" />
        <MenuItem Header="回滚指定提交（当前目录）…" Tag="reverse-merge-directory" Click="Operation_Click" />
        <MenuItem Header="提交当前目录…" Tag="commit-directory" Click="Operation_Click" />
        <MenuItem Header="清理工作副本" Tag="cleanup" Click="Operation_Click" />
        <MenuItem Header="目录差异" Tag="directory-diff" Click="Operation_Click" />
        <Separator />
        <MenuItem Header="切换分支…" Tag="switch" Click="Operation_Click" />
        <MenuItem Header="创建分支 / 标签…" Tag="branch" Click="Operation_Click" />
        <MenuItem Header="预览合并…" Tag="merge-preview" Click="Operation_Click" />
        <MenuItem Header="合并…" Tag="merge" Click="Operation_Click" />
      </MenuItem>
      <MenuItem Header="所选项目" SubmenuOpened="MainMenu_SubmenuOpened">
        <MenuItem Header="打开" Tag="open" Click="Operation_Click" />
        <MenuItem Header="在资源管理器中显示" Tag="show-in-explorer" Click="Operation_Click" />
        <MenuItem Header="更新到最新" Tag="update" Click="Operation_Click" />
        <MenuItem Header="更新到指定修订号…" Tag="update-revision" Click="Operation_Click" />
        <MenuItem Header="回滚指定提交（反向合并）…" Tag="reverse-merge" Click="Operation_Click" />
        <MenuItem Header="提交…" Tag="commit" Click="Operation_Click" />
        <MenuItem Header="添加到版本控制" Tag="add" Click="Operation_Click" />
        <MenuItem Header="忽略（仅本机）" Tag="ignore" Click="Operation_Click" />
        <MenuItem Header="删除…" Tag="delete" Click="Operation_Click" />
        <MenuItem Header="重命名 / 移动…" Tag="move" Click="Operation_Click" />
        <MenuItem Header="批量重命名…" Tag="batch-rename" Click="Operation_Click" />
        <MenuItem Header="撤销本地修改…" Tag="revert" Click="Operation_Click" />
        <Separator />
        <MenuItem Header="与服务器比较" Tag="compare-server" Click="Operation_Click" />
        <MenuItem Header="与基础版本比较" Tag="compare-base" Click="Operation_Click" />
        <MenuItem Header="比较历史版本…" Tag="compare-history" Click="Operation_Click" />
        <MenuItem Header="查看历史" Tag="log" Click="Operation_Click" />
        <MenuItem Header="逐行追溯（Blame）" Tag="blame" Click="Operation_Click" />
        <Separator />
        <MenuItem Header="获取锁…" Tag="lock" Click="Operation_Click" />
        <MenuItem Header="释放锁" Tag="unlock" Click="Operation_Click" />
        <MenuItem Header="解决冲突…" Tag="resolve" Click="Operation_Click" />
        <MenuItem Header="查看属性" Tag="properties" Click="Operation_Click" />
        <MenuItem Header="设置属性 / 忽略规则…" Tag="set-property" Click="Operation_Click" />
        <MenuItem Header="导出所选到文件夹…" Tag="export" Click="Operation_Click" />
      </MenuItem>
      <MenuItem x:Name="FavoritesMenu" Header="收藏" SubmenuOpened="Favorites_SubmenuOpened">
        <MenuItem Header="尚无收藏" IsEnabled="False" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Image Source="{StaticResource AppIcon}" Width="28" Height="28" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SVNRevDesk" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Text="{x:Static services:AppVersion.Display}" FontSize="11" Foreground="{StaticResource MutedText}"
                       ToolTip="编译时间（北京时间）；每次编译自动更新版本。" />
          </StackPanel>
        </StackPanel>
        <DockPanel IsEnabled="{Binding CanOperate}">
          <Button DockPanel.Dock="Left" Content="打开本地…" Click="OpenLocal_Click" />
          <Button DockPanel.Dock="Right" Content="打开地址" Style="{StaticResource PrimaryButton}" Click="OpenAddress_Click" />
          <ComboBox x:Name="AddressBox" IsEditable="True" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentLocations}"
                    Margin="8,3" ToolTip="输入 SVN URL 或本地工作副本路径，按 Enter 打开" PreviewKeyDown="AddressBox_PreviewKeyDown" />
        </DockPanel>
      </DockPanel>
    </Border>

    <DockPanel DockPanel.Dock="Top" Margin="16,8,16,0" IsEnabled="{Binding CanOperate}">
      <Button DockPanel.Dock="Right" Content="关闭会话" Click="CloseSession_Click" ToolTip="Ctrl+W：关闭当前会话，保留工作副本文件" />
      <ListBox x:Name="SessionTabs" SelectionChanged="SessionTabs_SelectionChanged" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
               ToolTip="打开其他工作副本或 URL 会新建会话；Ctrl+Tab / Ctrl+Shift+Tab 切换">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="White" /><Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectionBackground}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" MaxWidth="260" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="16,10,16,10" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="刷新状态" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" ToolTip="F5：重新检查本地和服务器；不会下载或更新文件" />
          <Button x:Name="UpdateSelectionButton" Content="更新所选" Tag="update" Click="Operation_Click" IsEnabled="{Binding CanUpdateSelection}" ToolTip="下载所选文件或目录的最新版本" />
          <Button x:Name="CommitSelectionButton" Content="提交所选…" Tag="commit" Click="Operation_Click" IsEnabled="{Binding CanCommitSelection}" />
          <Button x:Name="CompareSelectionButton" Content="文件比较" Tag="compare-server" Click="Operation_Click" IsEnabled="{Binding CanCompareSelection}" ToolTip="Ctrl+D：默认用 WinMerge 与服务器比较；目录显示差异摘要" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="取消操作" IsEnabled="{Binding CanCancel}" Click="Cancel_Click"
                ToolTip="停止当前 SVN 操作、后台服务器读取或预览；已完成的步骤不会回滚，不会关闭自动刷新。" />
        <CheckBox x:Name="PreviewToggle" DockPanel.Dock="Right" Content="预览" IsChecked="{Binding Preview.IsEnabled}" Margin="10,0,0,0"
                  VerticalAlignment="Center" ToolTip="开启或关闭文件预览；优先显示本地图片或小文本，缺失时按需读取服务器版本。" />
        <CheckBox DockPanel.Dock="Right" Content="自动刷新" IsChecked="{Binding AutoRefresh}" Margin="12,0,12,0"
                  VerticalAlignment="Center" ToolTip="前台定时检查，间隔可在设置中修改；不会下载文件" />
        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource ToolTipTextConverter}}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0} · {1}">
              <Binding Path="SnapshotText" />
              <Binding Path="AutoRefreshDescription" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,9">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Foreground="{StaticResource MutedText}" Margin="16,0,0,0" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding EntryCount}" Foreground="{StaticResource MutedText}" Margin="0,0,20,0" />
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage, Converter={StaticResource ToolTipTextConverter}}" />
      </DockPanel>
    </Border>
    <Border x:Name="OperationProgress" DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="16,0,16,10" Padding="14,10"
            Background="#EDF4FF" BorderBrush="#CDDEF7" Visibility="{Binding IsOperationProgressVisible, Converter={StaticResource BooleanToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding ProgressTitle}" FontWeight="SemiBold" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="{Binding ProgressTransferText}" Foreground="{StaticResource MutedText}" Margin="12,0" />
          <TextBlock x:Name="ProgressElapsed" Text="{Binding ProgressElapsedText}" Foreground="{StaticResource MutedText}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ProgressTarget}" ToolTip="{Binding ProgressTarget, Converter={StaticResource ToolTipTextConverter}}"
                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Height="5" Margin="0,9,0,9" IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}" Background="#DCE6F4" BorderThickness="0"
                     ToolTip="操作正在执行，大文件传输期间可能暂时没有新的文件通知。可点击“取消操作”停止。" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ProgressMessage}" ToolTip="{Binding ProgressMessage, Converter={StaticResource ToolTipTextConverter}}" TextTrimming="CharacterEllipsis" FontSize="12" />
      </Grid>
    </Border>
    <Expander DockPanel.Dock="Bottom" Header="操作记录" Margin="18,0,18,8" Foreground="{StaticResource MutedText}">
      <ListBox ItemsSource="{Binding ActivityLog}" Height="120" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderBrush="{StaticResource PanelBorder}" />
    </Expander>

    <Grid Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="248" MinWidth="180" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="14,14">
            <StackPanel>
              <TextBlock Text="仓库目录" FontWeight="SemiBold" />
              <TextBlock Text="展开目录，查看本地与服务器差异" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <TreeView x:Name="DirectoryTree" ItemsSource="{Binding Roots}" BorderThickness="0" Padding="8"
                    PreviewMouseLeftButtonDown="FileBrowser_PreviewMouseLeftButtonDown" PreviewMouseMove="FileBrowser_PreviewMouseMove"
                    AllowDrop="True" PreviewDragEnter="FileBrowser_PreviewDragOver" PreviewDragOver="FileBrowser_PreviewDragOver" PreviewDrop="FileBrowser_PreviewDrop"
                    ContextMenu="{StaticResource DirectoryContextMenu}" PreviewMouseRightButtonDown="DirectoryTree_PreviewMouseRightButtonDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    IsEnabled="{Binding CanOperate}" SelectedItemChanged="DirectoryTree_SelectedItemChanged" TreeViewItem.Expanded="DirectoryTree_Expanded">
            <TreeView.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6EFFB" />
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#26354A" />
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E6EFFB" />
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#26354A" />
            </TreeView.Resources>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="12,8">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding DirectoryOverview}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="12" />
                <Border Background="#EDF3FE" CornerRadius="5" Padding="9,5" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="{Binding DifferenceOverview}" Foreground="#356AC4" FontSize="12" />
                </Border>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsOnlineOnly, Converter={StaticResource BooleanToVisibility}}" IsEnabled="{Binding CanOperate}">
                <Button Content="关联本地…" Tag="associate" Click="Operation_Click" MinHeight="28" Padding="10,4" FontSize="12" ToolTip="{Binding Session.Url, StringFormat=选择对应浏览根地址的工作副本：{0}}" />
                <Button Content="检出到本地…" Tag="checkout" Click="Operation_Click" MinHeight="28" Padding="10,4" FontSize="12" />
              </StackPanel>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" MaxWidth="340" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentRelativePath"
                           ToolTip="{Binding CurrentRelativePathText, Converter={StaticResource ToolTipTextConverter}}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DirectoryCacheText}" Margin="16,0,0,0"
                           ToolTip="{Binding DirectoryCacheText, Converter={StaticResource ToolTipTextConverter}}"
                           Foreground="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DockPanel>
            <DockPanel x:Name="BackgroundReadIndicator" Margin="0,6,0,0" Visibility="{Binding IsReading, Converter={StaticResource BooleanToVisibility}}">
              <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#E3EBF8" BorderThickness="0" Width="38" Height="4" Margin="0,0,8,0" />
              <TextBlock Text="后台读取中，可继续浏览" ToolTip="{Binding ReadStatusMessage, Converter={StaticResource ToolTipTextConverter}}" Foreground="#356AC4" FontSize="11" />
            </DockPanel>
          </StackPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding CanOperate}">
          <Button DockPanel.Dock="Left" Content="↑ 上一级" Click="Parent_Click" IsEnabled="{Binding CanGoParent}" ToolTip="Alt+↑：返回上一级" Margin="0,0,8,0" />
          <Button x:Name="CrossDirectorySearchButton" DockPanel.Dock="Left" Content="跨目录搜索…" Click="Search_Click" IsEnabled="{Binding HasSession}" Margin="0,0,8,0" ToolTip="Ctrl+Shift+F：在独立窗口递归查找名称或路径，包含尚未下载的项目" />
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" Width="108" Margin="8,0,0,0" ToolTip="切换详细列表或卡片视图" />
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedState}" Width="142" Margin="8,0,0,0" ToolTip="按状态筛选当前目录" />
          <CheckBox DockPanel.Dock="Right" Content="只显示差异" IsChecked="{Binding DifferencesOnly}" Margin="10,0,0,0" VerticalAlignment="Center" />
          <Grid>
            <TextBox x:Name="NameFilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称筛选当前目录" />
            <TextBlock Text="筛选文件或目录名称…" Foreground="{StaticResource MutedText}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilterText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" /><ColumnDefinition x:Name="PreviewColumn" Width="0" MaxWidth="600" /></Grid.ColumnDefinitions>
        <DataGrid x:Name="FileGrid" ItemsSource="{Binding EntriesView}" SelectionMode="Extended" SelectionUnit="FullRow"
                  PreviewMouseMove="FileBrowser_PreviewMouseMove"
                  AllowDrop="True" PreviewDragEnter="FileBrowser_PreviewDragOver" PreviewDragOver="FileBrowser_PreviewDragOver" PreviewDrop="FileBrowser_PreviewDrop"
                  IsEnabled="{Binding CanOperate}" Visibility="{Binding IsDetailsView, Converter={StaticResource BooleanToVisibility}}"
                  ContextMenu="{StaticResource BrowserContextMenu}" RowStyle="{StaticResource FileRowStyle}"
                  MouseDoubleClick="FileGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="FileBrowser_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="FileGrid_PreviewMouseRightButtonDown" SelectionChanged="FileSelection_Changed">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="38" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Image Width="20" Height="22" Source="{Binding Converter={StaticResource FileIconConverter}}" ToolTip="{Binding Converter={StaticResource FileIconConverter}, ConverterParameter=label}" />
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="210" ElementStyle="{StaticResource IgnoredNameStyle}" />
            <DataGridTemplateColumn Header="状态" Width="126" SortMemberPath="StateText"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Border Style="{StaticResource StateBadge}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IgnoredSymbolStyle}" /><TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="本地最后修改" Binding="{Binding LocalRevisionText}" SortMemberPath="LocalRevision" Width="112" />
            <DataGridTextColumn Header="服务器最后修改" Binding="{Binding ServerRevisionText}" SortMemberPath="ServerRevision" Width="124" />
            <DataGridTemplateColumn Header="锁定人" Width="90" SortMemberPath="LockOwner"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <TextBlock Text="{Binding LockOwner}" ToolTip="{Binding LockDetail}" VerticalAlignment="Center" Foreground="#8253B7" />
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="目录差异（已检查项）" Binding="{Binding Summary}" Width="195" />
            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90">
              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding SizeDetail}" /></Style></DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="提交人" Binding="{Binding Author}" Width="100" />
            <DataGridTextColumn Header="本地基础版本" Binding="{Binding BaseRevisionText}" SortMemberPath="BaseRevision" Width="112" />
            <DataGridTextColumn Header="服务器修改时间" Binding="{Binding ChangedAtText}" SortMemberPath="ChangedAt" Width="152" />
            <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="260" />
          </DataGrid.Columns>
        </DataGrid>
        <ListBox x:Name="FileCards" ItemsSource="{Binding EntriesView}" SelectionMode="Extended"
                 PreviewMouseMove="FileBrowser_PreviewMouseMove"
                 AllowDrop="True" PreviewDragEnter="FileBrowser_PreviewDragOver" PreviewDragOver="FileBrowser_PreviewDragOver" PreviewDrop="FileBrowser_PreviewDrop"
                 Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibility}}" IsEnabled="{Binding CanOperate}"
                 Background="{StaticResource PageBackground}" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource FileCardStyle}" ContextMenu="{StaticResource BrowserContextMenu}"
                 MouseDoubleClick="FileCards_MouseDoubleClick" PreviewMouseLeftButtonDown="FileBrowser_PreviewMouseLeftButtonDown"
                 PreviewMouseRightButtonDown="FileCards_PreviewMouseRightButtonDown" SelectionChanged="FileSelection_Changed">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="28" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid.ToolTip><StackPanel MaxWidth="380">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateText}" Margin="0,5,0,0" /><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /><TextBlock Text="{Binding LockDetail}" Margin="0,5,0,0" />
              </StackPanel></Grid.ToolTip>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="30" Height="34" Source="{Binding Converter={StaticResource FileIconConverter}}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource IgnoredNameStyle}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" FontSize="12" />
                  <TextBlock Text="{Binding Converter={StaticResource FileIconConverter}, ConverterParameter=label}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
              <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Right" Text="{Binding LockOwner, StringFormat=锁：{0}}" ToolTip="{Binding LockDetail}" Foreground="#8253B7" FontSize="11" MaxWidth="82" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LockOwner}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource StateBadge}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IgnoredSymbolStyle}" /><TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border>
              </DockPanel>
              <TextBlock Grid.Row="2" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                <Run Text="本地 " /><Run Text="{Binding LocalRevisionText, Mode=OneWay}" /><Run Text="  ·  服务器 " /><Run Text="{Binding ServerRevisionText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Grid.Row="3" Foreground="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding SizeText}" /><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Text" Value="{Binding Summary}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="EmptyState" Background="Transparent" IsHitTestVisible="False">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VisibleEntryCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" Orientation="Horizontal">
            <Image Source="{StaticResource FileIconFolderOpen}" Width="44" Height="40" Opacity="0.6" Margin="0,0,16,0" VerticalAlignment="Center" />
            <StackPanel MaxWidth="300" VerticalAlignment="Center">
              <TextBlock Text="{Binding EmptyStateTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EmptyStateDescription}" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
          <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                        Visibility="{Binding Preview.IsEnabled, Converter={StaticResource BooleanToVisibility}}" />
          <views:FilePreviewPane x:Name="PreviewPane" Grid.Column="2" DataContext="{Binding Preview}"
                                 Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
