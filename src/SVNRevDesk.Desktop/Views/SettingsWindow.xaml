<Window x:Class="SVNRevDesk.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SVNRevDesk.Desktop.Services"
        Title="设置" Icon="../Assets/AppIcon.ico" Width="720" Height="620" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
  <Border Background="{StaticResource PageBackground}" Padding="20">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" Background="Transparent" BorderBrush="{StaticResource PanelBorder}">
      <TabItem Header="常规" Padding="18,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20" VerticalAlignment="Top">
            <TextBlock Text="SVN 客户端" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="SvnPathBox" />
            <TextBlock Text="svn.exe 表示使用内置客户端；自定义路径不存在时回退到内置客户端。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20" />
            <TextBlock Text="比较工具可执行文件（留空使用内置 WinMerge）" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="DiffPathBox" />
            <TextBlock Text="文件比较直接打开内置 WinMerge，窗口自动适应当前屏幕。自定义工具需要接受两个文件路径参数。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20" />
            <TextBlock Text="服务器自动刷新间隔" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="RefreshMinutesBox" Width="110" />
              <TextBlock Text="分钟（至少 0.25 分钟，可填小数）" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="默认 1 小时（60 分钟）。自动刷新只在窗口处于前台时执行，不会下载文件。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20" />
            <TextBlock Text="点击窗口关闭按钮时" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="CloseBehaviorBox" SelectedValuePath="Tag">
              <ComboBoxItem Content="每次询问" Tag="{x:Static services:WindowCloseBehavior.Ask}" />
              <ComboBoxItem Content="最小化到系统托盘" Tag="{x:Static services:WindowCloseBehavior.MinimizeToTray}" />
              <ComboBoxItem Content="直接退出软件" Tag="{x:Static services:WindowCloseBehavior.Exit}" />
            </ComboBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="备份管理" Padding="18,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20" VerticalAlignment="Top">
            <CheckBox x:Name="AutoCleanupBox" Content="自动清理过期备份" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="保留最近" VerticalAlignment="Center" />
              <TextBox x:Name="RetentionDaysBox" Width="90" Margin="10,0" TextChanged="RetentionDaysBox_TextChanged" />
              <TextBlock Text="天的备份" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="默认保留 30 天。启动时检查，运行期间每 24 小时检查一次；后台执行，无需连接 SVN 服务器。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16" />
            <Border Style="{StaticResource Panel}" Padding="14">
              <StackPanel>
                <TextBlock x:Name="BackupSummaryText" Text="正在统计备份…" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="ExpiredSummaryText" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock x:Name="BackupDetailsText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="BackupPathText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,8" />
            <WrapPanel>
              <Button Content="打开备份目录" Click="OpenBackups_Click" />
              <Button x:Name="RefreshBackupsButton" Content="重新统计" Click="RefreshBackups_Click" />
              <Button x:Name="CleanBackupsButton" Content="清理过期备份…" IsEnabled="False" Click="CleanBackups_Click" />
              <Button x:Name="CleanAllBackupsButton" Content="清理全部备份…" IsEnabled="False" Click="CleanAllBackups_Click"
                      ToolTip="不受保留天数限制，确认后删除软件生成的所有可清理备份。" />
            </WrapPanel>
            <TextBlock Text="备份包含覆盖、撤销或删除前的本地内容，以及旧 SVN 依赖。超过保留期限后将删除；需要长期保存的文件请移至其他目录。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" />
            <ProgressBar x:Name="CleanupProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,14,0,0" />
            <TextBlock x:Name="CleanupMessageText" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationText" Foreground="#BF3B4E" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="Save_Click" />
        <Button Content="取消" IsCancel="True" MinWidth="90" />
      </StackPanel>
    </Grid>
  </Grid>
  </Border>
</Window>
