<Window x:Class="SVNRevDesk.Desktop.Views.NewItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建" Icon="../Assets/AppIcon.ico" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Padding="20" Background="{StaticResource PageBackground}">
    <StackPanel>
      <TextBlock x:Name="TargetPath" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />
      <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />
      <TextBlock x:Name="TypeDescription" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="12" />
      <CheckBox x:Name="AddToSvnBox" Content="创建后添加到 SVN" IsChecked="True" Margin="0,16,0,0" />
      <TextBlock x:Name="ValidationText" Foreground="#BF3B4E" TextWrapping="Wrap" Margin="0,9,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="CreateButton" Content="创建" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="Create_Click" />
        <Button Content="取消" IsCancel="True" MinWidth="90" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
