<UserControl x:Class="SVNRevDesk.Desktop.Views.FilePreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="PreviewVisibility" /></UserControl.Resources>
  <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="12,8,8,8">
        <Button x:Name="ClosePreviewButton" DockPanel.Dock="Right" Content="×" Click="Close_Click" Padding="8,2" MinHeight="26" FontSize="18" ToolTip="关闭预览" />
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="12,0,12,8">
        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
        <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource PreviewVisibility}}" />
      </StackPanel>
      <Grid Grid.Row="2" Margin="8,0,8,8">
        <Border Background="#F3F6FA" CornerRadius="5" Visibility="{Binding HasImage, Converter={StaticResource PreviewVisibility}}">
          <Image Source="{Binding Image}" Stretch="Uniform" VerticalAlignment="Top" Margin="8" />
        </Border>
        <TextBox Text="{Binding Text, Mode=OneWay}" Visibility="{Binding HasText, Converter={StaticResource PreviewVisibility}}"
                 IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="8" />
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="6,12" VerticalAlignment="Top">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers>
            <DataTrigger Binding="{Binding HasContent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="12,0,12,12" FontSize="11" Foreground="{StaticResource MutedText}"
                 TextWrapping="Wrap" Visibility="{Binding HasContent, Converter={StaticResource PreviewVisibility}}" />
    </Grid>
  </Border>
</UserControl>
