<Window x:Class="SVNRevDesk.Desktop.Views.CloseWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 SVNRevDesk" Icon="../Assets/AppIcon.ico" Width="470"
        SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{StaticResource PageBackground}" Padding="22">
  <StackPanel>
    <TextBlock Text="请选择关闭方式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
    <Border Style="{StaticResource Panel}" Padding="14">
      <StackPanel>
        <RadioButton x:Name="MinimizeOption" GroupName="CloseBehavior" Content="最小化到系统托盘" IsChecked="True" FontWeight="SemiBold" />
        <TextBlock Text="软件继续运行，双击托盘图标可恢复窗口。" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="20,6,0,18" />
        <RadioButton x:Name="ExitOption" GroupName="CloseBehavior" Content="直接退出软件" FontWeight="SemiBold" />
        <TextBlock Text="关闭软件；正在执行的 SVN 操作会先询问是否取消。" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="20,6,0,0" />
      </StackPanel>
    </Border>
    <CheckBox x:Name="RememberChoiceBox" Content="记住我的选择（可在设置中修改）" Margin="0,16,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ConfirmButton" Content="确定" IsDefault="True" MinWidth="85" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
      <Button Content="取消" IsCancel="True" MinWidth="85" />
    </StackPanel>
  </StackPanel>
  </Border>
</Window>
