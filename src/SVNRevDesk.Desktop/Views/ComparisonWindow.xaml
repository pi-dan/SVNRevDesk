<Window x:Class="SVNRevDesk.Desktop.Views.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件比较" Width="1180" Height="760" MinWidth="800" MinHeight="450" WindowStartupLocation="CenterOwner">
  <Grid Margin="12" Background="{StaticResource PageBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="上一处差异" Click="Previous_Click" />
        <Button Content="下一处差异" Click="Next_Click" />
        <Button x:Name="ExternalButton" Content="WinMerge 比较" Click="External_Click" />
      </StackPanel>
      <TextBlock x:Name="SummaryLabel" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,8,0" TextWrapping="Wrap" />
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock x:Name="LeftLabel" TextWrapping="Wrap" Margin="6" />
      <TextBlock x:Name="RightLabel" Grid.Column="1" TextWrapping="Wrap" Margin="6" />
    </Grid>
    <DataGrid x:Name="DiffGrid" Grid.Row="2" SelectionMode="Single" RowHeight="26" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" SizeChanged="DiffGrid_SizeChanged">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers><DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="Background" Value="#FFF0D2" /></DataTrigger></Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="行" Binding="{Binding LeftNumber}" Width="55" />
        <DataGridTextColumn Header="左侧内容" Binding="{Binding LeftText}" Width="480" />
        <DataGridTextColumn Header="行" Binding="{Binding RightNumber}" Width="55" />
        <DataGridTextColumn Header="右侧内容" Binding="{Binding RightText}" Width="480" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
